#!/bin/sh
STATE=${FAKE_STATE:?}
printf '%s\n' "$*" >> "$STATE/calls.log"

label_of() {
    ref=$1
    column=$2
    if [ -f "$STATE/labels" ]; then
        awk -F'|' -v ref="$ref" -v col="$column" '$1 == ref { print $col; exit }' "$STATE/labels"
    fi
}

dbs() {
    if [ ! -f "$STATE/dbs" ]; then
        printf 'stealthnet|\n' > "$STATE/dbs"
    fi
}

db_has() {
    dbs
    grep -q "^$1|" "$STATE/dbs"
}

db_set() {
    dbs
    grep -v "^$1|" "$STATE/dbs" > "$STATE/dbs.tmp"
    printf '%s|%s\n' "$1" "$2" >> "$STATE/dbs.tmp"
    mv "$STATE/dbs.tmp" "$STATE/dbs"
}

db_drop() {
    dbs
    grep -v "^$1|" "$STATE/dbs" > "$STATE/dbs.tmp"
    mv "$STATE/dbs.tmp" "$STATE/dbs"
}

db_rename() {
    comment=$(grep "^$1|" "$STATE/dbs" | sed 's/^[^|]*|//')
    db_drop "$1"
    db_set "$2" "$comment"
}

sql() {
    q=$1
    dbs
    case "$q" in
        "SELECT 1 FROM pg_database WHERE datname = '"*)
            name=${q#*datname = \'}
            name=${name%\'}
            if db_has "$name"; then echo 1; fi
            ;;
        "SELECT coalesce(shobj_description"*)
            name=${q#*datname = \'}
            name=${name%\'}
            grep "^$name|" "$STATE/dbs" | sed 's/^[^|]*|//'
            ;;
        "SELECT pg_database_size"*)
            echo "${FAKE_DB_SIZE:-1048576}"
            ;;
        "CREATE DATABASE stealthnet_next TEMPLATE stealthnet")
            [ "${FAKE_CLONE_EXIT:-0}" -eq 0 ] || return 1
            db_has stealthnet_next && return 1
            db_set stealthnet_next ""
            ;;
        "COMMENT ON DATABASE "*" IS NULL")
            name=${q#COMMENT ON DATABASE }
            name=${name%% *}
            db_set "$name" ""
            ;;
        "COMMENT ON DATABASE "*)
            name=${q#COMMENT ON DATABASE }
            name=${name%% *}
            text=${q#*IS \'}
            text=${text%\'}
            db_set "$name" "$text"
            ;;
        "BEGIN; ALTER DATABASE stealthnet RENAME TO stealthnet_prev; ALTER DATABASE stealthnet_next RENAME TO stealthnet; COMMIT;")
            [ "${FAKE_SWAP_EXIT:-0}" -eq 0 ] || return 1
            db_rename stealthnet stealthnet_prev
            db_rename stealthnet_next stealthnet
            ;;
        "BEGIN; ALTER DATABASE stealthnet RENAME TO stealthnet_next; ALTER DATABASE stealthnet_prev RENAME TO stealthnet; COMMIT;")
            db_rename stealthnet stealthnet_next
            db_rename stealthnet_prev stealthnet
            ;;
        "DROP DATABASE "*)
            db_drop "${q#DROP DATABASE }"
            ;;
        *)
            echo "fake psql: неизвестный запрос: $q" >&2
            return 1
            ;;
    esac
    return 0
}

mod_file() {
    printf '%s/mod_%s' "$STATE" "$1"
}

mod_set() {
    printf '%s|%s\n' "$2" "$3" > "$(mod_file "$1")"
}

last_word() {
    all="$*"
    printf '%s' "${all##* }"
}

case "$*" in
    "compose version"*) exit 0 ;;
    "network inspect stealthnet-modules-internal"*) [ -f "$STATE/net_inner" ]; exit $? ;;
    "network inspect stealthnet-modules"*) [ -f "$STATE/net_modules" ]; exit $? ;;
    "network create"*)
        case "$(last_word "$@")" in
            stealthnet-modules) : > "$STATE/net_modules" ;;
            stealthnet-modules-internal) : > "$STATE/net_inner" ;;
        esac
        exit 0 ;;
    "network connect "*) exit 0 ;;
    "run --rm --network none --read-only "*" module-unpack "*)
        out=""
        for a in "$@"; do
            case "$a" in
                type=bind,source=*,target=/out) out=${a#type=bind,source=}; out=${out%,target=/out} ;;
            esac
        done
        [ -n "$out" ] || exit 3
        if [ "${FAKE_UNPACK:-ok}" = "ok" ]; then
            printf 'module=%s\nimage=%s\nport=8095\nhealth=/healthz\nmemory=128\ncpus=0.5\ninternet=1\nvolume=data:/data\n' \
                "${FAKE_MODULE:-nodes}" "${FAKE_TAG:-stealthnet-module/nodes:0123456789ab}" > "$out/spec"
            if [ -n "${FAKE_SPEC_EXTRA:-}" ]; then printf '%s\n' "$FAKE_SPEC_EXTRA" >> "$out/spec"; fi
            printf 'image' > "$out/image.tar"
            exit 0
        fi
        printf '"%s"\n' "${FAKE_UNPACK_ERROR:-образ не тот}" > "$out/error.json"
        exit 1 ;;
    "load -i "*)
        tag=${FAKE_LOADED:-${FAKE_TAG:-stealthnet-module/nodes:0123456789ab}}
        echo "Loaded image: $tag"
        printf '%s\n' "$tag" >> "$STATE/images"
        exit "${FAKE_LOAD_EXIT:-0}" ;;
    "volume inspect -f {{.Mountpoint}} "*)
        dir="$STATE/volroot/$(last_word "$@")"
        mkdir -p "$dir"
        printf 'x' > "$dir/file"
        echo "$dir"
        exit 0 ;;
    "volume inspect "*) [ -f "$STATE/vol_$(last_word "$@")" ]; exit $? ;;
    "volume create "*) : > "$STATE/vol_$(last_word "$@")"; exit 0 ;;
    "volume ls -q --filter label=org.stealthnet.module="*)
        for f in "$STATE"/vol_*; do
            if [ -f "$f" ]; then echo "${f##*/vol_}"; fi
        done
        exit 0 ;;
    "volume rm "*) rm -f "$STATE/vol_$(last_word "$@")"; exit 0 ;;
    "run --rm --network none --user 0:0 "*" chown "*) exit 0 ;;
    "run -d --name sn-mod-"*)
        printf '%s\n' "$*" >> "$STATE/module_runs"
        [ "${FAKE_RUN_EXIT:-0}" -eq 0 ] || exit "$FAKE_RUN_EXIT"
        name=${4:-}
        mod_set "$name" running "$(last_word "$@")"
        exit 0 ;;
    "rm -f sn-mod-"*) rm -f "$(mod_file "$(last_word "$@")")"; exit 0 ;;
    "stop -t "*" sn-mod-"*)
        f=$(mod_file "$(last_word "$@")")
        if [ -f "$f" ]; then mod_set "$(last_word "$@")" exited "$(cut -d'|' -f2 "$f")"; fi
        exit 0 ;;
    "start sn-mod-"*|"restart -t 20 sn-mod-"*)
        f=$(mod_file "$(last_word "$@")")
        [ -f "$f" ] || exit 1
        mod_set "$(last_word "$@")" running "$(cut -d'|' -f2 "$f")"
        exit 0 ;;
    "inspect -f {{.State.Status}}|{{.State.StartedAt}}|{{.RestartCount}}|{{.Config.Image}} sn-mod-"*)
        f=$(mod_file "$(last_word "$@")")
        [ -f "$f" ] || exit 1
        echo "$(cut -d'|' -f1 "$f")|2026-11-24T10:00:00.123456789Z|0|$(cut -d'|' -f2 "$f")"
        exit 0 ;;
    "inspect -f {{.State.Status}} sn-mod-"*)
        f=$(mod_file "$(last_word "$@")")
        [ -f "$f" ] || exit 1
        cut -d'|' -f1 "$f"
        exit 0 ;;
    "inspect sn-mod-"*) [ -f "$(mod_file "$(last_word "$@")")" ]; exit $? ;;
    "exec abc123 curl -fsS -o /dev/null --max-time 3 http://sn-mod-"*)
        printf '%s\n' "$(last_word "$@")" >> "$STATE/module_probes"
        current=$(cut -d'|' -f2 "$(mod_file sn-mod-"${FAKE_MODULE:-nodes}")" 2>/dev/null || true)
        if [ -n "${FAKE_BAD_IMAGE:-}" ] && [ "$current" = "$FAKE_BAD_IMAGE" ]; then exit 1; fi
        exit "${FAKE_MODULE_HEALTH:-0}" ;;
    "logs --tail 200 sn-mod-"*)
        echo "модуль слушает 0.0.0.0:8095"
        printf '\033[31mкрасная строка\033[0m\n'
        exit 0 ;;
    "stats --no-stream --format {{.MemUsage}} sn-mod-"*) echo "61.2MiB / 128MiB"; exit 0 ;;
    "image ls --format {{.Repository}}:{{.Tag}} stealthnet-module/"*)
        grep '^stealthnet-module/' "$STATE/images" 2>/dev/null | sort -u
        exit 0 ;;
    "ps -a --filter label=org.stealthnet.module "*)
        for f in "$STATE"/mod_sn-mod-*; do
            if [ -f "$f" ]; then
                name=${f##*/mod_sn-mod-}
                echo "$name|$(cut -d'|' -f1 "$f")|$(cut -d'|' -f2 "$f")"
            fi
        done
        exit 0 ;;
    "info -f"*) echo "${FAKE_HOST_ARCH:-x86_64}"; exit 0 ;;
    "info"*) exit "${FAKE_INFO_EXIT:-0}" ;;
    pull*)
        all="$*"
        ref=${all##* }
        ok=1
        if [ "${FAKE_PULL_EXIT:-1}" -eq 0 ]; then ok=0; fi
        if [ -n "${FAKE_PULL_OK:-}" ]; then
            case "$ref" in *"$FAKE_PULL_OK") ok=0 ;; esac
        fi
        if [ "$ok" -eq 0 ]; then
            echo "[fake] pulled $ref"
            printf '%s\n' "$ref" "${FAKE_DIGEST:-ghcr.io/stealthnet-app/stealthnet-rw-system@sha256:1111}" >> "$STATE/images"
        else
            echo "manifest unknown" >&2
        fi
        exit "$ok" ;;
    "image inspect -f {{.Architecture}}"*) echo "${FAKE_IMAGE_ARCH:-amd64}"; exit 0 ;;
    "image inspect -f {{range .RepoDigests}}{{println .}}{{end}}"*)
        echo "${FAKE_OTHER_DIGEST:-}"
        echo "${FAKE_DIGEST:-ghcr.io/stealthnet-app/stealthnet-rw-system@sha256:1111}"
        exit 0 ;;
    "image inspect -f {{index .Config.Labels \"org.opencontainers.image.revision\"}} "*)
        all="$*"
        label_of "${all##* }" 2
        exit 0 ;;
    "image inspect -f {{index .Config.Labels \"org.opencontainers.image.created\"}} "*)
        all="$*"
        label_of "${all##* }" 3
        exit 0 ;;
    "image inspect -f {{index .Config.Labels \"org.opencontainers.image.version\"}} "*)
        all="$*"
        label_of "${all##* }" 4
        exit 0 ;;
    "image inspect -f {{.Created}} "*) exit 0 ;;
    "image inspect"*)
        all="$*"
        ref=${all##* }
        grep -Fxq "$ref" "$STATE/images" 2>/dev/null
        exit $? ;;
    "image rm"*)
        all="$*"
        ref=${all##* }
        if [ -f "$STATE/images" ]; then grep -Fxv "$ref" "$STATE/images" > "$STATE/images.tmp"; mv "$STATE/images.tmp" "$STATE/images"; fi
        exit 0 ;;
    "compose up -d --no-build"*)
        echo "[fake] starting prebuilt image"
        if [ "${FAKE_UP_EXIT:-0}" -eq 0 ]; then
            : > "$STATE/started"
            sed -n 's/^SN_IMAGE=//p' .env 2>/dev/null | tail -n 1 >> "$STATE/started_images"
        fi
        exit "${FAKE_UP_EXIT:-0}" ;;
    "network inspect remnawave-network"*) exit "${FAKE_REMNA_EXIT:-1}" ;;
    "compose up -d --build"*)
        echo "[fake] building image"
        sleep "${FAKE_UP_SLEEP:-0}"
        if [ "${FAKE_UP_EXIT:-0}" -eq 0 ]; then
            : > "$STATE/started"
            printf 'commit=%s date=%s version=%s\n' "${SN_BUILD_COMMIT:-}" "${SN_BUILD_DATE:-}" "${SN_BUILD_VERSION:-}" >> "$STATE/builds"
        fi
        exit "${FAKE_UP_EXIT:-0}" ;;
    "compose ps -q app"*)
        if [ -f "$STATE/started" ]; then echo "abc123"; fi
        exit 0 ;;
    "compose ps -q postgres"*)
        if [ -f "$STATE/started" ]; then echo "pg123"; fi
        exit 0 ;;
    "compose stop -t 60 app")
        if [ "${FAKE_STOP_EXIT:-0}" -eq 0 ]; then rm -f "$STATE/started"; fi
        exit "${FAKE_STOP_EXIT:-0}" ;;
    "compose run --rm --no-deps -T "*" app migrate")
        printf 'image=%s %s\n' "${SN_IMAGE:-}" "$*" >> "$STATE/migrations"
        exit "${FAKE_MIGRATE_EXIT:-0}" ;;
    "exec abc123 curl -fsS http://127.0.0.1:8080/api/health")
        exit "${FAKE_APP_HEALTH:-0}" ;;
    "inspect -f {{.RestartCount}} "*) echo "${FAKE_RESTARTS:-0}"; exit 0 ;;
    "inspect -f {{.Config.Image}} "*)
        sed -n 's/^SN_IMAGE=//p' .env 2>/dev/null | tail -n 1
        exit 0 ;;
    inspect*)
        n=$(cat "$STATE/health_calls" 2>/dev/null || echo 0)
        n=$((n + 1))
        echo "$n" > "$STATE/health_calls"
        if [ "$n" -le "${FAKE_STARTING:-0}" ]; then echo starting; else echo "${FAKE_HEALTH:-healthy}"; fi
        exit 0 ;;
    "compose exec -T postgres pg_dump"*)
        [ "${FAKE_DUMP_EXIT:-0}" -eq 0 ] || exit 1
        printf 'PGDMP fake dump\n'
        exit 0 ;;
    "compose exec -T postgres pg_restore --list"*)
        cat > /dev/null
        exit 0 ;;
    "compose exec -T postgres psql -U stealthnet -d postgres "*)
        all="$*"
        sql "${all#* -c }"
        exit $? ;;
    "compose exec -T postgres psql"*" -f -")
        all="$*"
        email=${all##*email=}
        email=${email%% -f -}
        cat > /dev/null
        if [ "${FAKE_UPDATE_EXIT:-0}" -eq 0 ]; then printf '%s' "$email" > "$STATE/owner.txt"; fi
        exit "${FAKE_UPDATE_EXIT:-0}" ;;
    "compose exec -T postgres psql"*) cat "$STATE/owner.txt" 2>/dev/null; exit "${FAKE_DB_EXIT:-0}" ;;
    "compose exec -T app stealthnet create-admin --email "*)
        all="$*"
        email=${all##*--email }
        IFS= read -r pw
        printf '%s' "$email" > "$STATE/owner.txt"
        printf '%s' "$pw" > "$STATE/password.txt"
        echo "Владелец создан"
        exit 0 ;;
    "compose exec -T app stealthnet unlock-login --email "*)
        [ "${FAKE_UNLOCK_EXIT:-0}" -eq 0 ] || exit "${FAKE_UNLOCK_EXIT}"
        echo "Вход для $(cat "$STATE/owner.txt") с новых адресов был закрыт из-за подбора пароля. Блокировка снята."
        exit 0 ;;
    "compose exec -T app stealthnet backup")
        [ "${FAKE_BACKUP_EXIT:-0}" -eq 0 ] || exit "${FAKE_BACKUP_EXIT}"
        echo "Копия сохранена: /var/lib/stealthnet/backups/stealthnet-backup-20261118-040000-manual.tar.gz"
        exit 0 ;;
    "compose run --rm --no-deps -T -e SN_RUN_BOT=false -e SN_RUN_WORKER=false app restore --password-stdin --check "*)
        IFS= read -r pw
        printf '%s' "$pw" > "$STATE/restore_password.txt"
        [ "${FAKE_RESTORE_CHECK_EXIT:-0}" -eq 0 ] || { echo "ошибка: файл копии повреждён"; exit "${FAKE_RESTORE_CHECK_EXIT}"; }
        echo "Копия от 18.11.2026 04:00 (+03:00), по расписанию, версия 0.1.200"
        exit 0 ;;
    "compose run --rm --no-deps -T -e SN_RUN_BOT=false -e SN_RUN_WORKER=false app restore --password-stdin --yes "*)
        cat > /dev/null
        [ "${FAKE_RESTORE_EXIT:-0}" -eq 0 ] || exit "${FAKE_RESTORE_EXIT}"
        : > "$STATE/restored"
        echo "Готово: база восстановлена из копии."
        exit 0 ;;
    "compose exec -T caddy find "*" -delete")
        printf '%s\n' "$*" >> "$STATE/cert_deleted"
        rm -f "$STATE/cert"
        exit 0 ;;
    "compose exec -T caddy find "*)
        if [ "${FAKE_CERT:-1}" = "1" ] || [ -f "$STATE/cert" ]; then echo "/data/caddy/certificates/acme/site/site.crt"; fi
        exit 0 ;;
    "compose restart caddy")
        if [ "${FAKE_CERT_AFTER_RESTART:-0}" = "1" ]; then : > "$STATE/cert"; fi
        echo "[fake] caddy restarted"
        exit "${FAKE_RESTART_EXIT:-0}" ;;
    "compose logs"*)
        if [ -n "${FAKE_CADDY_LOG:-}" ]; then printf '%s\n' "$FAKE_CADDY_LOG"; else echo "[fake] logs"; fi
        exit 0 ;;
    "compose restart") echo "[fake] restarted"; exit "${FAKE_RESTART_EXIT:-0}" ;;
    "compose stop") echo "[fake] stopped"; exit 0 ;;
esac
echo "fake docker: неизвестный вызов: $*" >&2
exit 97
