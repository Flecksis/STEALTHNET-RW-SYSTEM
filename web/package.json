{
  "name": "stealthnet-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/i18n-check.mjs && tsc --noEmit && vite build",
    "i18n": "node scripts/i18n-check.mjs --report --loose",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'src/**/*.test.mjs'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "country-flag-icons": "1.6.20",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
